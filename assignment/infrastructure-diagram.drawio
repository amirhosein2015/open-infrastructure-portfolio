<mxfile host="app.diagrams.net"><diagram name="Simplified Infrastructure" id="simple"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="1" pageWidth="980" pageHeight="560"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="off" value="&lt;b&gt;Company office&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="10" y="45" width="330" height="415" as="geometry"/></mxCell><mxCell id="lap" value="&lt;b&gt;15 employees on company laptops&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;STAFF VLAN 10&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="85" width="290" height="60" as="geometry"/></mxCell><mxCell id="gst" value="&lt;b&gt;Guest devices&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GUEST VLAN 20 (internet only)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="160" width="290" height="55" as="geometry"/></mxCell><mxCell id="mg" value="&lt;b&gt;Network administration&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MGMT VLAN 99&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="230" width="290" height="55" as="geometry"/></mxCell><mxCell id="fw" value="&lt;b&gt;Firewall + managed switch + Wi-Fi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;single policy point between VLANs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="310" width="290" height="70" as="geometry"/></mxCell><mxCell id="net" value="&lt;b&gt;Internet&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="290" width="160" height="48" as="geometry"/></mxCell><mxCell id="entra" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;single identity source&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MFA, separate admin accounts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="385" y="45" width="200" height="100" as="geometry"/></mxCell><mxCell id="pipe" value="&lt;b&gt;Git repository + pipeline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;build once, promote:&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Dev &gt; Staging &gt; approval &gt; Prod&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="385" y="385" width="200" height="90" as="geometry"/></mxCell><mxCell id="m365" value="&lt;b&gt;Microsoft 365&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="630" y="45" width="330" height="120" as="geometry"/></mxCell><mxCell id="m365b" value="&lt;b&gt;Email, Teams, SharePoint, OneDrive&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(data protected by built-in recovery)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="645" y="85" width="300" height="65" as="geometry"/></mxCell><mxCell id="az" value="&lt;b&gt;Azure: one subscription&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="630" y="235" width="330" height="265" as