<mxfile host="app.diagrams.net">
  <diagram name="05 DevOps Deployment Workflow" id="devops-deployment-workflow">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t1" value="Diagram 5 — DevOps Deployment Workflow" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="700" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="Proposed process. Conceptual: no pipeline has been built or tested. One artifact is built once and promoted." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="36" width="900" height="20" as="geometry"/>
        </mxCell>

        <!-- Row A: source control and review -->
        <mxCell id="a1" value="Git&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;short-lived branch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="Pull Request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="80" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="Code review&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;approval and required checks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="80" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="Merge to protected main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="80" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- CI container -->
        <mxCell id="ci" value="CI pipeline (runs on pull request, and on merge to main)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="185" width="920" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="ci1" value="Build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="ci">
          <mxGeometry x="20" y="45" width="190" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ci2" value="Automated tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="ci">
          <mxGeometry x="250" y="45" width="190" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ci3" value="Security checks&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;tooling not selected&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="ci">
          <mxGeometry x="480" y="45" width="190" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ci4" value="Versioned artifact&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;built once, immutable (main only)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="ci">
          <mxGeometry x="710" y="45" width="190" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ce1" style="html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;" edge="1" parent="ci" source="ci1" target="ci2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce2" style="html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;" edge="1" parent="ci" source="ci2" target="ci3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce3" style="html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;" edge="1" parent="ci" source="ci3" target="ci4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Row C: promotion -->
        <mxCell id="c1" value="Deploy to Development&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;automatic, health check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="345" width="200" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="Deploy to Staging&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;same artifact, smoke and integration checks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="345" width="220" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="Production approval&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;approver is not the requester&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="555" y="330" width="210" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="Deploy to Production&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;same artifact, scoped identity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="345" width="150" height="65" as="geometry"/>
        </mxCell>

        <!-- Rollback and IaC -->
        <mxCell id="r1" value="Rollback&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;redeploy previous artifact; slot swap only if the product supports it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="480" width="400" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="i1" value="Infrastructure as code (Bicep, concept)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;same pull request and review path, change preview, deployed by the environment identity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="470" height="65" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="a1" target="a2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="a2" target="a3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="approved" style="html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="a3" target="a4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="triggers" style="html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a4" target="ci">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="promotes artifact" style="html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=10;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ci" target="c1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="checks pass" style="html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="c1" target="c2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="validated" style="html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="c2" target="c3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="approved" style="html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="if a problem is found" style="html=1;endArrow=block;dashed=1;strokeWidth=2;strokeColor=#666666;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="r1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Notes -->
        <mxCell id="n1" value="Environments are not branches: every environment deploys the same artifact built from main. Environment-specific values live in configuration and in each environment's Key Vault, never in a rebuilt binary. Each environment has its own deployment identity, scoped to its resource group, using a federated credential rather than a stored secret where the product supports it. Developers do not hold standing production administrator rights. Approval and branch-protection features depend on the chosen Git or pipeline product and plan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="575" width="920" height="90" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
