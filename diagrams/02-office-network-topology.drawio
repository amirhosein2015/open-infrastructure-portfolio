<mxfile host="app.diagrams.net">
  <diagram name="02 Office Network Topology" id="office-network-topology">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t1" value="Diagram 2 — Office Network Topology" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="700" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="Proposed design. VLAN IDs and IP addresses are examples. Not deployed." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="36" width="700" height="20" as="geometry"/>
        </mxCell>

        <!-- Core chain -->
        <mxCell id="net" value="Internet" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="120" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="isp" value="ISP equipment (single line)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="200" y="90" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="fw" value="Firewall&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;routing, DHCP, DNS, rules&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="90" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sw" value="Managed switch&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;802.1Q VLANs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="90" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ap" value="Wireless access points&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;count set by site survey&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="90" width="150" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="ec1" style="html=1;endArrow=block;startArrow=block;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="net" target="isp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ec2" value="internet edge" style="html=1;endArrow=block;startArrow=block;strokeWidth=2;strokeColor=#b85450;fontSize=9;" edge="1" parent="1" source="isp" target="fw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ec3" value="trunk" style="html=1;endArrow=block;startArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=9;" edge="1" parent="1" source="fw" target="sw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ec4" value="trunk" style="html=1;endArrow=block;startArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=9;" edge="1" parent="1" source="sw" target="ap">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- VLAN 10 Staff -->
        <mxCell id="v10" value="VLAN 10 — STAFF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="290" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="v10a" value="Wired company laptops (switch access ports)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="v10">
          <mxGeometry x="15" y="40" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="v10b" value="CORP-WIFI: wireless company laptops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="v10">
          <mxGeometry x="15" y="90" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="v10c" value="10.10.10.0/24 · gateway .1 · DHCP .100 to .220" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="v10">
          <mxGeometry x="15" y="145" width="260" height="40" as="geometry"/>
        </mxCell>

        <!-- VLAN 20 Guest -->
        <mxCell id="v20" value="VLAN 20 — GUEST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="355" y="260" width="290" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="v20a" value="GUEST-WIFI: visitor and personal devices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="v20">
          <mxGeometry x="15" y="40" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="v20b" value="Client isolation where supported" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="v20">
          <mxGeometry x="15" y="90" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="v20c" value="10.10.20.0/24 · gateway .1 · DHCP .100 to .220 · internet access only" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="v20">
          <mxGeometry x="15" y="145" width="260" height="40" as="geometry"/>
        </mxCell>

        <!-- VLAN 99 Management -->
        <mxCell id="v99" value="VLAN 99 — MANAGEMENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="670" y="260" width="290" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="v99a" value="Firewall, switch, and access point management interfaces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="v99">
          <mxGeometry x="15" y="40" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="v99b" value="Designated admin workstation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="v99">
          <mxGeometry x="15" y="90" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="v99c" value="10.10.99.0/24 · static addresses · no SSID" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="v99">
          <mxGeometry x="15" y="145" width="260" height="40" as="geometry"/>
        </mxCell>

        <!-- Switch to VLAN segments (staggered waypoints to avoid overlaps) -->
        <mxCell id="es10" value="VLAN 10" style="html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=10;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sw" target="v10">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="561" y="190"/>
              <mxPoint x="185" y="190"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="es20" value="VLAN 20" style="html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sw" target="v20">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="610" y="215"/>
              <mxPoint x="500" y="215"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="es99" value="VLAN 99" style="html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=10;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sw" target="v99">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="659" y="240"/>
              <mxPoint x="815" y="240"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Policy summary -->
        <mxCell id="pol" value="Firewall policy summary: default deny between segments. STAFF may reach the internet. GUEST may reach the internet only. MANAGEMENT is reachable only from the designated admin workstation. No unsolicited inbound traffic from the internet. VLANs by themselves do not provide security; the firewall rules and switch port and trunk settings enforce the isolation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="485" width="920" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="lg" value="Access points are trunked to the switch and broadcast one SSID per VLAN (CORP-WIFI on VLAN 10, GUEST-WIFI on VLAN 20). The management VLAN is never exposed through an SSID." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="565" width="920" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
