<mxfile host="app.diagrams.net">
  <diagram name="04 Azure Resource Architecture" id="azure-resource-architecture">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t1" value="Diagram 4 — Azure Resource Architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="700" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="Proposed design. Names are examples. Hosting and data products are intentionally not selected (ADR-004). Not deployed." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="36" width="900" height="20" as="geometry"/>
        </mxCell>

        <!-- Control inputs -->
        <mxCell id="ent" value="Microsoft Entra ID&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;groups and Azure RBAC at resource-group scope&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="440" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="devops" value="DevOps pipeline&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;one build artifact, deployed with a scoped identity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="70" width="440" height="45" as="geometry"/>
        </mxCell>

        <!-- Subscription -->
        <mxCell id="sub" value="Azure subscription (one, linked to the Entra tenant) — logical separation, not complete isolation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f0fa;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=3;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="145" width="920" height="470" as="geometry"/>
        </mxCell>

        <!-- Dev RG -->
        <mxCell id="rgd" value="rg-app-dev — Development" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=5;" vertex="1" parent="sub">
          <mxGeometry x="15" y="40" width="285" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="rgd1" value="Hosting tier (product deferred)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="rgd">
          <mxGeometry x="15" y="40" width="255" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="rgd2" value="Data tier (product deferred)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="rgd">
          <mxGeometry x="15" y="88" width="255" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="rgd3" value="Storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="rgd">
          <mxGeometry x="15" y="136" width="255" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="rgd4" value="Key Vault: kv-app-dev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="rgd">
          <mxGeometry x="15" y="184" width="255" height="38" as="geometry"/>
        </mxCell>

        <!-- Staging RG -->
        <mxCell id="rgs" value="rg-app-stg — Staging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=5;" vertex="1" parent="sub">
          <mxGeometry x="320" y="40" width="285" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="rgs1" value="Hosting tier (product deferred)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="rgs">
          <mxGeometry x="15" y="40" width="255" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="rgs2" value="Data tier (product deferred)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="rgs">
          <mxGeometry x="15" y="88" width="255" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="rgs3" value="Storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="rgs">
          <mxGeometry x="15" y="136" width="255" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="rgs4" value="Key Vault: kv-app-stg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="rgs">
          <mxGeometry x="15" y="184" width="255" height="38" as="geometry"/>
        </mxCell>

        <!-- Prod RG -->
        <mxCell id="rgp" value="rg-app-prod — Production" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=5;" vertex="1" parent="sub">
          <mxGeometry x="625" y="40" width="285" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="rgp1" value="Hosting tier (product deferred)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="rgp">
          <mxGeometry x="15" y="40" width="255" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="rgp2" value="Data tier (product deferred)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="rgp">
          <mxGeometry x="15" y="88" width="255" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="rgp3" value="Storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="rgp">
          <mxGeometry x="15" y="136" width="255" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="rgp4" value="Key Vault: kv-app-prod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="rgp">
          <mxGeometry x="15" y="184" width="255" height="38" as="geometry"/>
        </mxCell>

        <!-- Shared ops RG -->
        <mxCell id="rgo" value="rg-shared-ops — Shared operations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=5;" vertex="1" parent="sub">
          <mxGeometry x="15" y="305" width="895" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="rgo1" value="Azure Monitor and Log Analytics workspace&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Application Insights where supported&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="rgo">
          <mxGeometry x="15" y="40" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="rgo2" value="Backup vault for Azure workloads&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;not for Microsoft 365 data (ADR-006)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="rgo">
          <mxGeometry x="305" y="40" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="rgo3" value="Alert rules and budgets&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;budgets alert only; they do not stop resources&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="rgo">
          <mxGeometry x="595" y="40" width="285" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="rgo4" value="Standard tags on every resource: environment, application, owner, cost-center, data-classification" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="rgo">
          <mxGeometry x="15" y="105" width="865" height="30" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="Azure RBAC" style="html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent" target="sub">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="deploys the same artifact" style="html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="devops" target="sub">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Notes -->
        <mxCell id="n1" value="Environments are separated logically by resource group, role scope, tags, and per-environment Key Vaults. This is not complete security isolation: an administrator or identity with subscription-scope rights can reach every environment, and quotas are shared. Production changes arrive only through the pipeline; developers hold no standing production administrator rights. No virtual network, VPN, or Kubernetes is part of the baseline (ADR-005)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="920" height="70" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
